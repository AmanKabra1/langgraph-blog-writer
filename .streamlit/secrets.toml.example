# =====================================================================
# Secrets template
#
# NEVER commit a filled-in copy of this file. `.streamlit/secrets.toml` is
# gitignored; on Streamlit Community Cloud paste the contents into
# App settings -> Secrets instead, where they are encrypted at rest.
#
# The app runs fine with NONE of this set — it just falls back to asking each
# visitor for their own keys, with no login. Fill it in when you want a shared
# deployment running on your credentials.
# =====================================================================


# ---------------------------------------------------------------------
# 1. Your API keys — what every signed-in visitor will spend
# ---------------------------------------------------------------------
GROQ_API_KEY   = "gsk_REPLACE_ME"    # required — console.groq.com/keys
TAVILY_API_KEY = "tvly-REPLACE_ME"   # optional — app.tavily.com
GOOGLE_API_KEY = "AIza_REPLACE_ME"   # optional — aistudio.google.com/apikey


# ---------------------------------------------------------------------
# 2. Google sign-in
#
# Setting this block ON is what turns the login gate on. Without it there is
# no login and no daily limit, and visitors supply their own keys.
#
# Create the client at console.cloud.google.com:
#   APIs & Services -> Credentials -> Create credentials
#     -> OAuth client ID -> Web application
#   Authorised redirect URIs must contain BOTH of:
#     http://localhost:8501/oauth2callback
#     https://<your-app>.streamlit.app/oauth2callback
#
# cookie_secret: any long random string. Generate one with
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------
[auth]
redirect_uri  = "https://<your-app>.streamlit.app/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

[auth.google]
client_id           = "REPLACE_ME.apps.googleusercontent.com"
client_secret       = "GOCSPX-REPLACE_ME"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"


# ---------------------------------------------------------------------
# 3. Who may use it, and how much
#
# Leave allowed_emails and allowed_domains out entirely to let ANY Google
# account sign in. Listing either one restricts access to those matches.
# ---------------------------------------------------------------------
[access]
daily_run_limit = 5                                 # blog runs per user per UTC day; 0 = unlimited
admins          = ["you@example.com"]               # bypass the limit, see the usage panel
# allowed_emails  = ["friend@example.com"]          # uncomment to restrict to named people
# allowed_domains = ["yourcompany.com"]             # uncomment to restrict to a domain

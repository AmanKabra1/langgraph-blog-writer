# OPTIONAL. The app never requires this file — every key can be typed into the
# sidebar at runtime.
#
# Fill it in only if you want a deployed instance to start with keys already
# loaded. Locally: copy to `.streamlit/secrets.toml` (gitignored).
# On Streamlit Community Cloud: paste the contents into
# App settings -> Secrets.

GROQ_API_KEY   = "gsk_..."   # required for generation — console.groq.com/keys
TAVILY_API_KEY = "tvly-..."  # optional, enables research — app.tavily.com
GOOGLE_API_KEY = "AIza..."   # optional, enables diagrams — aistudio.google.com/apikey
